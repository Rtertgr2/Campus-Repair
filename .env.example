# URL ของ backend PHP (ใส่ตอน build — เว้นว่าง = ใช้ข้อมูลตัวอย่างในหน่วยความจำ)
#
# ติดตั้งที่ htdocs/campus-repair : /campus-repair/api/index.php
# ติดตั้งที่ราก htdocs            : /api/index.php
VITE_API_URL=

# path ที่เว็บถูกติดตั้ง (ใช้ตอน build)
#   "/"                = htdocs ราก
#   "/campus-repair/"  = โฟลเดอร์ย่อยใน htdocs
VITE_BASE_PATH=/

# --- ฝั่งเซิร์ฟเวอร์ (ไม่ใช้กับ frontend) ---
# backend PHP ตั้งค่าที่ api/config.php (คัดลอกจาก api/config.example.php)
# ห้ามใส่ความลับในตัวแปรที่ขึ้นต้นด้วย VITE_ เพราะจะถูกฝังลง JS ฝั่งเบราว์เซอร์
