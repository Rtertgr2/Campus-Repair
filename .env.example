[TEMPLATE]
# Google Apps Script web app URL (Deploy > Web app > /exec URL)
# Leave empty to run against the built-in in-memory sample data.
VITE_API_URL=

# --- Database connector (prepared, not used by the app yet) ---
# Neon Postgres connection string, read only by the server-side code in /db.
# Keep it empty to leave the connector disabled. Never prefix it with VITE_:
# that would ship the credential to the browser.
DATABASE_URL=
