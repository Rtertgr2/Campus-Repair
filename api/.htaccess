# ปลอดภัยขึ้นเมื่อรันบน Apache/XAMPP
Options -Indexes

# ไม่ให้เรียกไฟล์ config/ฐานข้อมูลผ่านเบราว์เซอร์
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
